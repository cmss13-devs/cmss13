        {
            "type": "process",
            "command": "tools/build/build.sh",
            "windows": {
                "command": ".\\tools\\build\\build.bat",
                "args": [
                    "-DRUNTIME_MAP",
                    "-DQUICK_START"
                ]
            },
            "options": {
                "env": {
                    "DM_EXE": "${config:dreammaker.byondPath}"
                }
            },
            "problemMatcher": [
                "$dreammaker",
