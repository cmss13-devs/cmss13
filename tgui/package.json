{
  "private": true,
  "name": "tgui-workspace",
  "version": "6.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tgui:analyze": "bun x --bun rspack --analyze",
    "tgui:build": "bun x --bun rspack build",
    "tgui:dev": "bun packages/tgui-dev-server/index.ts",
    "tgui:lint": "eslint packages --ext .js,.jsx,.cjs,.ts,.tsx",
    "tgui:prettier": "prettier --check .",
    "tgui:test": "bun test",
    "tgui:tsc": "tsc",
    "tgui:prettier-fix": "bun x --bun prettier --write .",
    "tgui:eslint-fix": "bun x --bun eslint --fix packages --ext .js,.jsx,.cjs,.ts,.jsx,.tsx"
  },
  "dependencies": {
    "@rspack/cli": "^2.2.2",
    "@rspack/core": "^2.2.2",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript-eslint/utils": "^8.69.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.103.1",
    "sass-loader": "^17.0.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.12.0",
    "@swc/register": "^0.1.10",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/webpack-env": "^1.18.8",
    "@types/wicg-file-system-access": "^2023.10.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1"
  }
}
